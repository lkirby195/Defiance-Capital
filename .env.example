# Copy to .env (gitignored). SQLAlchemy URL for the Postgres database.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/glenwood_uw

# Key the review-queue session cookie is signed with (SPEC §11). No default: a default
# would be a signing key every copy of this repository knows, which is no signature at all.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out, which is the way to end every live session at once.
SESSION_SECRET=

# Optional: a THROWAWAY database for the DB-backed tests (tables are dropped and recreated).
# Without it those tests run on an embedded PostgreSQL from the pgserver dev dependency.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/glenwood_uw_test
