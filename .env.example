# Copy to .env (gitignored). SQLAlchemy URL for the Postgres database.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/glenwood_uw

# Key the review-queue session cookie is signed with (SPEC §11). No default: a default
# would be a signing key every copy of this repository knows, which is no signature at all.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out, which is the way to end every live session at once.
SESSION_SECRET=

# Optional: the RentCast API key (SPEC 6.2). With it, every deal is enriched on arrival with
# the AVM, the rent estimate, the comps and the property record, and the deal page's Refresh
# market data button is live; without it the adapter is off and the team's own entries stand.
# Keys are issued at https://app.rentcast.io/app/api; the free tier is 50 requests a month
# (config rentcast.monthly_request_budget), and one deal is three requests.
# RENTCAST_API_KEY=

# Optional: Cloudflare Turnstile on /apply and Adjust my numbers (SPEC 4.2, v0.26). Both or
# neither: with either unset the form has no widget and no check (README.md, "Turnstile").
# The widget only draws on a hostname the Cloudflare widget lists, so leave these unset
# locally unless localhost is on it.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional: serve FastAPI's /docs, /redoc and /openapi.json, which are off otherwise. Read
# from the shell when the app starts, not from this file: GLENWOOD_API_DOCS=1 uv run uvicorn ...

# Optional: a THROWAWAY database for the DB-backed tests (tables are dropped and recreated).
# Without it those tests run on an embedded PostgreSQL from the pgserver dev dependency.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/glenwood_uw_test
