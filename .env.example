# Copy to .env (gitignored). SQLAlchemy URL for the Postgres database.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/glenwood_uw
# Optional: a THROWAWAY database for the DB-backed tests (tables are dropped and recreated).
# Without it those tests are skipped.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/glenwood_uw_test
