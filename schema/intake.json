{
  "$defs": {
    "AssetType": {
      "description": "Subject-property asset type; drives the exit inference with the term.  # SPEC \u00a73",
      "enum": [
        "SFR",
        "UNITS_2_4",
        "UNITS_5_PLUS",
        "OTHER"
      ],
      "title": "AssetType",
      "type": "string"
    },
    "BorrowerInfo": {
      "additionalProperties": false,
      "description": "Who the borrower is; credit and experience are self-reported here.  # SPEC \u00a74.5",
      "properties": {
        "credit_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tranche"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "entity_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Name"
        },
        "experience_bucket": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExperienceBucket"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone"
        },
        "repeat_borrower": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repeat Borrower"
        }
      },
      "title": "BorrowerInfo",
      "type": "object"
    },
    "Channel": {
      "description": "Intake channel.  # SPEC \u00a74.2",
      "enum": [
        "SMS",
        "LINK",
        "CONTRACT",
        "TEAM"
      ],
      "title": "Channel",
      "type": "string"
    },
    "CourtFlag": {
      "description": "Stable codes for the court and filing flags; severity is config.  # SPEC \u00a77.2",
      "enum": [
        "BANKRUPTCY_IN_LOOKBACK",
        "ACTIVE_FORECLOSURE_AS_OWNER",
        "UNSATISFIED_JUDGMENT_OVER_THRESHOLD",
        "OPEN_TAX_LIEN",
        "ACTIVE_CIVIL_LITIGATION_AS_DEFENDANT",
        "SATISFIED_JUDGMENT_OR_RELEASED_LIEN_IN_LOOKBACK",
        "LANDLORD_TENANT_AS_LANDLORD",
        "SUBJECT_PROPERTY_LIEN_OR_LIS_PENDENS"
      ],
      "title": "CourtFlag",
      "type": "string"
    },
    "CourtRecordsStatus": {
      "description": "What the team found when they searched the courts by hand.  # SPEC \u00a76, \u00a77.2\n\nThe court-record adapters are Phase 3; until then a person searches OSCN, PACER or the\ncounty and records the outcome here. NOT_CHECKED is not the same as CLEAN: the screen\nflags the first as unknown (INFO) and treats the second as a clean record.",
      "enum": [
        "NOT_CHECKED",
        "CLEAN",
        "FLAGS"
      ],
      "title": "CourtRecordsStatus",
      "type": "string"
    },
    "DealInfo": {
      "additionalProperties": false,
      "description": "Deal terms as requested by the borrower.  # SPEC \u00a74.5",
      "properties": {
        "actual_annual_insurance_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Annual Insurance Usd"
        },
        "actual_annual_taxes_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Annual Taxes Usd"
        },
        "actual_annual_utilities_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Annual Utilities Usd"
        },
        "arv_team": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arv Team"
        },
        "as_is_value_team": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Is Value Team"
        },
        "asset_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "court_records_as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Court Records As Of"
        },
        "court_records_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/CourtRecordsStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "court_records_team": {
          "items": {
            "$ref": "#/$defs/TeamCourtRecord"
          },
          "title": "Court Records Team",
          "type": "array"
        },
        "loan_purchase_portion": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loan Purchase Portion"
        },
        "loan_rehab_portion": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loan Rehab Portion"
        },
        "loan_requested": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Loan Requested"
        },
        "market_rent_monthly": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Market Rent Monthly"
        },
        "product": {
          "anyOf": [
            {
              "$ref": "#/$defs/Product"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "product_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProductSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "purchase_price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purchase Price"
        },
        "rehab_budget": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rehab Budget"
        },
        "stated_exit": {
          "anyOf": [
            {
              "$ref": "#/$defs/StatedExit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "term_bucket": {
          "anyOf": [
            {
              "$ref": "#/$defs/TermBucket"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "term_months": {
          "anyOf": [
            {
              "maximum": 60,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Term Months"
        }
      },
      "title": "DealInfo",
      "type": "object"
    },
    "ExperienceBucket": {
      "description": "Self-reported deals completed in the last 3 years.  # SPEC \u00a74.1",
      "enum": [
        "0",
        "1_2",
        "3_5",
        "6_PLUS"
      ],
      "title": "ExperienceBucket",
      "type": "string"
    },
    "LienKind": {
      "description": "Subject-property encumbrance types.  # SPEC \u00a77.2",
      "enum": [
        "LIEN",
        "LIS_PENDENS"
      ],
      "title": "LienKind",
      "type": "string"
    },
    "Product": {
      "description": "Loan products.  # SPEC \u00a73",
      "enum": [
        "NO_DRAW",
        "SPLIT_DRAW",
        "SPLIT_PRINCIPAL",
        "WHOLETAIL"
      ],
      "title": "Product",
      "type": "string"
    },
    "ProductSource": {
      "description": "Whether ``deal.product`` was entered by the team or inferred by the normalizer.",
      "enum": [
        "ENTERED",
        "INFERRED"
      ],
      "title": "ProductSource",
      "type": "string"
    },
    "PropertyInfo": {
      "additionalProperties": false,
      "description": "Subject property; address or listing URL satisfies the minimum.  # SPEC \u00a74.5",
      "properties": {
        "address_normalized": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address Normalized"
        },
        "address_raw": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address Raw"
        },
        "county": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "County"
        },
        "listing_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Listing Url"
        },
        "state": {
          "$ref": "#/$defs/State",
          "default": "OTHER"
        },
        "state_source": {
          "$ref": "#/$defs/StateSource",
          "default": "INFERRED"
        }
      },
      "title": "PropertyInfo",
      "type": "object"
    },
    "State": {
      "description": "Property state; anything outside OK/CO is OTHER.  # SPEC \u00a74.5",
      "enum": [
        "OK",
        "CO",
        "OTHER"
      ],
      "title": "State",
      "type": "string"
    },
    "StateSource": {
      "description": "Whether ``property.state`` was entered by a person or inferred from the address.",
      "enum": [
        "ENTERED",
        "INFERRED"
      ],
      "title": "StateSource",
      "type": "string"
    },
    "StatedExit": {
      "description": "Borrower-stated exit, confirmed by the team.  # SPEC \u00a73, \u00a74.5",
      "enum": [
        "FLIP",
        "HOLD",
        "WHOLETAIL",
        "UNKNOWN"
      ],
      "title": "StatedExit",
      "type": "string"
    },
    "Status": {
      "description": "Deal lifecycle status.  # SPEC \u00a74.5",
      "enum": [
        "NEW",
        "NEEDS_INFO",
        "SCREENED",
        "IN_REVIEW",
        "UNDERWRITING",
        "LOI_SENT",
        "HANDED_OFF",
        "DECLINED",
        "DEAD"
      ],
      "title": "Status",
      "type": "string"
    },
    "TeamCourtRecord": {
      "additionalProperties": false,
      "description": "One court or filing matter the team found by hand, typed by the flag it feeds.\n\nThe team is the court-record source until the Phase 3 adapters land (SPEC \u00a76). Each\nentry carries the facts the screen's own test for that code needs (SPEC \u00a77.2) - the date\nfor the two lookback codes, the amount for the three threshold codes, the lien facts for\na subject-property encumbrance - so the config thresholds still decide the outcome\nrather than the team asserting a verdict. One matter per entry; a code with no matter is\nsimply absent.",
      "properties": {
        "amount_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount Usd"
        },
        "code": {
          "$ref": "#/$defs/CourtFlag"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "lien_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/LienKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "occurred_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurred On"
        },
        "resolved_at_close": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved At Close"
        },
        "senior": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Senior"
        }
      },
      "required": [
        "code"
      ],
      "title": "TeamCourtRecord",
      "type": "object"
    },
    "TermBucket": {
      "description": "Requested loan term in months.  # SPEC \u00a74.1",
      "enum": [
        "3",
        "6",
        "9",
        "12",
        "12_PLUS"
      ],
      "title": "TermBucket",
      "type": "string"
    },
    "Tranche": {
      "description": "Credit tranches; cutoffs live in config.  # SPEC \u00a77.1",
      "enum": [
        "T1",
        "T2",
        "T3",
        "T4",
        "T5"
      ],
      "title": "Tranche",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Canonical intake record; one per property x borrower inquiry.  # SPEC \u00a74.5",
  "properties": {
    "borrower": {
      "$ref": "#/$defs/BorrowerInfo"
    },
    "channel": {
      "$ref": "#/$defs/Channel"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deal": {
      "$ref": "#/$defs/DealInfo"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "missing_fields": {
      "items": {
        "type": "string"
      },
      "title": "Missing Fields",
      "type": "array"
    },
    "property": {
      "$ref": "#/$defs/PropertyInfo"
    },
    "raw_payload": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "string"
        }
      ],
      "title": "Raw Payload"
    },
    "status": {
      "$ref": "#/$defs/Status",
      "default": "NEW"
    }
  },
  "required": [
    "channel",
    "raw_payload"
  ],
  "title": "IntakeRecord",
  "type": "object"
}
